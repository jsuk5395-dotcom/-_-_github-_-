<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 음주운전 의심 신고 시 신고자(내 차량) 위치 조회용. 정밀 위치는 서버로 보내지 않는다
         (중계를 켜도 발행은 약 100m 격자, 수신 조회는 약 1km 격자만 전송). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />

    <!-- 차량 속도(PERF_VEHICLE_SPEED) 읽기용. AAOS 런타임 권한이며 MainActivity에서 요청한다. -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <!-- 주변 차량·보행자 안전 알림 중계 서버(backend/hazard-relay) 통신용.
         기본값은 꺼짐(MOCK)이며 사용자가 중계를 켜야만 네트워크를 사용한다. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 전화·문자 앱 존재 여부 확인용. 직접 통화/문자 권한은 요청하지 않는다. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pnu_me">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Pnu_me"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 앱 내부 전용 차량 데이터 감시 서비스 (SAFE DRIVE 이식). 외부 호출 불가. -->
        <service
            android:name=".platform.vehicle.DrivingMonitorService"
            android:enabled="true"
            android:exported="false" />
    </application>

</manifest>